# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Address of the site, used in meta tags and the sitemap.
NEXT_PUBLIC_SITE_URL=

# Requests from the forms are sent to Telegram: bot token from @BotFather and the chat that receives them.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Yandex Metrica counter number. Webvisor turns on with it.
NEXT_PUBLIC_YM_ID=
